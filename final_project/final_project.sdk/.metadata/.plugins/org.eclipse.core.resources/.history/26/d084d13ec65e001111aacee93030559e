#include "xil_printf.h"
#include <stdint.h>

#define N 1000000

volatile int32_t sink = 0;

static inline uint32_t get_cycles() {
    uint32_t cycles;
    asm volatile ("mfs %0, rmsr" : "=r"(cycles));
    return cycles;
}

int main() {
    uint32_t start, end, elapsed;

    xil_printf("\r\n=== Multiply Benchmark (N=%d) ===\r\n\r\n", N);

    // int8
    {
        volatile int8_t a = 127, b = 64;
        volatile int8_t acc = 0;

        start = get_cycles();

        for (int i = 0; i < N; i++)
            acc += a * b;

        end = get_cycles();

        sink = acc;
        elapsed = end - start;

        xil_printf("int8:             %d cycles (%d cyc/op)\r\n",
                   elapsed, elapsed / N);
    }

    // int16
    {
        volatile int16_t a = 32767, b = 64;
        volatile int16_t acc = 0;

        start = get_cycles();

        for (int i = 0; i < N; i++)
            acc += a * b;

        end = get_cycles();

        sink = acc;
        elapsed = end - start;

        xil_printf("int16:            %d cycles (%d cyc/op)\r\n",
                   elapsed, elapsed / N);
    }

    // int32
    {
        volatile int32_t a = 100000, b = 64;
        volatile int32_t acc = 0;

        start = get_cycles();

        for (int i = 0; i < N; i++)
            acc += a * b;

        end = get_cycles();

        sink = acc;
        elapsed = end - start;

        xil_printf("int32:            %d cycles (%d cyc/op)\r\n",
                   elapsed, elapsed / N);
    }

    // int8 -> int32 MAC
    {
        volatile int8_t a = 127, b = 64;
        volatile int32_t acc = 0;

        start = get_cycles();

        for (int i = 0; i < N; i++)
            acc += (int32_t)a * (int32_t)b;

        end = get_cycles();

        sink = acc;
        elapsed = end - start;

        xil_printf("int8->int32 MAC:  %d cycles (%d cyc/op)\r\n",
                   elapsed, elapsed / N);
    }

    // float
    {
        volatile float a = 1.5f, b = 2.5f;
        volatile float acc = 0.0f;

        start = get_cycles();

        for (int i = 0; i < N; i++)
            acc += a * b;

        end = get_cycles();

        sink = (int32_t)acc;
        elapsed = end - start;

        xil_printf("fp32:             %d cycles (%d cyc/op)\r\n",
                   elapsed, elapsed / N);
    }

    xil_printf("\r\n=== Done ===\r\n");

    while (1);
    return 0;
}

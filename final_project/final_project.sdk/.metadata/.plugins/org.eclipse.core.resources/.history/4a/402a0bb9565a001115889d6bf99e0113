#include "xil_printf.h"
#include "xparameters.h"
#include "xgpio.h"
#include "cnn.h"
#include "weights.h"

#define BRAM_BASE XPAR_AXI_BRAM_CTRL_0_S_AXI_BASEADDR

XGpio frame_gpio;
signed char input_buf[784];

int main() {
    xil_printf("CNN ready\r\n");

    XGpio_Initialize(&frame_gpio, XPAR_AXI_GPIO_1_DEVICE_ID);
    XGpio_SetDataDirection(&frame_gpio, 1, 0xFFFFFFFF);

    while (1) {
        // wait for downsample_28x28 to finish a frame
        while ((XGpio_DiscreteRead(&frame_gpio, 1) & 0x1) == 0);

        // read 784 bytes from BRAM
        for (int i = 0; i < 784; i++) {
            uint8_t px = *(volatile uint8_t*)(BRAM_BASE + i);
            input_buf[i] = (signed char)(px >> 1);
        }

        int digit = infer(input_buf);
        xil_printf("Digit: %d\r\n", digit);
    }
    return 0;
}

#include "xil_printf.h"
#include <stdint.h>
#define N 1000000
volatile int32_t sink = 0;

static inline uint32_t get_cycles() {
    uint32_t cycles;
    asm volatile ("mfs %0, rpc" : "=r"(cycles));
    return cycles;
}

int main() {
    uint32_t start, end;
    xil_printf("\r\n=== Benchmark ===\r\n");

    // int8 multiply-accumulate
    {
        volatile int8_t a = 100;
        volatile int8_t b = 64;
        volatile int32_t acc = 0;
        start = get_cycles();
        for (int i = 0; i < N; i++) {
            acc += (int32_t)a * (int32_t)b;
        }
        end = get_cycles();
        sink = acc;
        xil_printf("int8 MAC:    %d cycles\r\n", (int)(end - start));
    }

    // int32 multiply-accumulate
    {
        volatile int32_t a = 100;
        volatile int32_t b = 64;
        volatile int32_t acc = 0;
        start = get_cycles();
        for (int i = 0; i < N; i++) {
            acc += a * b;
        }
        end = get_cycles();
        sink = acc;
        xil_printf("int32 MAC:   %d cycles\r\n", (int)(end - start));
    }

    // float multiply-accumulate
    {
        volatile float a = 100.0f;
        volatile float b = 64.0f;
        volatile float acc = 0.0f;
        start = get_cycles();
        for (int i = 0; i < N; i++) {
            acc += a * b;
        }
        end = get_cycles();
        sink = (int32_t)acc;
        xil_printf("float MAC:   %d cycles\r\n", (int)(end - start));
    }

    // float multiply then round (mirrors your requantization)
    {
        volatile int32_t acc_int = 12345;
        volatile float s = 0.00787f;
        volatile int32_t result = 0;
        start = get_cycles();
        for (int i = 0; i < N; i++) {
            float val = (float)acc_int * s;
            result = (int32_t)(val + (val >= 0.0f ? 0.5f : -0.5f));
        }
        end = get_cycles();
        sink = result;
        xil_printf("float requant: %d cycles\r\n", (int)(end - start));
    }

    while(1);
}

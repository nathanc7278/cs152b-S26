#include "xil_printf.h"
#include "xtime_l.h"
#include <stdint.h>

#define N 1000000

volatile int32_t sink = 0;

static inline uint64_t elapsed_cycles(XTime start, XTime end) {
    return (uint64_t)(end - start);
}

int main() {
    XTime start, end;

    xil_printf("\r\n=== Multiply Benchmark (N=%d) ===\r\n\r\n", N);

    // int8
    {
        volatile int8_t a = 127, b = 64;
        volatile int8_t acc = 0;

        XTime_GetTime(&start);
        for (int i = 0; i < N; i++)
            acc += a * b;
        XTime_GetTime(&end);

        sink = acc;

        uint64_t cycles = elapsed_cycles(start, end);

        xil_printf("int8:             %llu cycles (%llu cyc/op)\r\n",
                   cycles, cycles / N);
    }

    // int16
    {
        volatile int16_t a = 32767, b = 64;
        volatile int16_t acc = 0;

        XTime_GetTime(&start);
        for (int i = 0; i < N; i++)
            acc += a * b;
        XTime_GetTime(&end);

        sink = acc;

        uint64_t cycles = elapsed_cycles(start, end);

        xil_printf("int16:            %llu cycles (%llu cyc/op)\r\n",
                   cycles, cycles / N);
    }

    // int32
    {
        volatile int32_t a = 100000, b = 64;
        volatile int32_t acc = 0;

        XTime_GetTime(&start);
        for (int i = 0; i < N; i++)
            acc += a * b;
        XTime_GetTime(&end);

        sink = acc;

        uint64_t cycles = elapsed_cycles(start, end);

        xil_printf("int32:            %llu cycles (%llu cyc/op)\r\n",
                   cycles, cycles / N);
    }

    // int8 * int8 -> int32 MAC
    {
        volatile int8_t a = 127, b = 64;
        volatile int32_t acc = 0;

        XTime_GetTime(&start);
        for (int i = 0; i < N; i++)
            acc += (int32_t)a * (int32_t)b;
        XTime_GetTime(&end);

        sink = acc;

        uint64_t cycles = elapsed_cycles(start, end);

        xil_printf("int8->int32 MAC:  %llu cycles (%llu cyc/op)\r\n",
                   cycles, cycles / N);
    }

    // fp32
    {
        volatile float a = 1.5f, b = 2.5f;
        volatile float acc = 0.0f;

        XTime_GetTime(&start);
        for (int i = 0; i < N; i++)
            acc += a * b;
        XTime_GetTime(&end);

        sink = (int32_t)acc;

        uint64_t cycles = elapsed_cycles(start, end);

        xil_printf("fp32:             %llu cycles (%llu cyc/op)\r\n",
                   cycles, cycles / N);
    }

    xil_printf("\r\n=== Done ===\r\n");

    while (1);
    return 0;
}

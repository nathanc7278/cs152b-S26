#include "xil_printf.h"
#include "xparameters.h"
#include "xtmrctr.h"
#include <stdint.h>

#define N 1000000
volatile int32_t sink = 0;

XTmrCtr timer;

void timer_init() {
    XTmrCtr_Initialize(&timer, XPAR_TMRCTR_0_DEVICE_ID);
    XTmrCtr_SetOptions(&timer, 0, XTC_AUTO_RELOAD_OPTION);
}

uint32_t get_cycles() {
    return XTmrCtr_GetValue(&timer, 0);
}

int main() {
    timer_init();
    xil_printf("\r\n=== Benchmark ===\r\n");

    // int8 MAC
    {
        volatile int8_t a = 100;
        volatile int8_t b = 64;
        volatile int32_t acc = 0;
        XTmrCtr_Start(&timer, 0);
        for (int i = 0; i < N; i++) {
            acc += (int32_t)a * (int32_t)b;
        }
        uint32_t elapsed = XTmrCtr_GetValue(&timer, 0);
        XTmrCtr_Stop(&timer, 0);
        sink = acc;
        xil_printf("int8 MAC:      %d cycles\r\n", (int)elapsed);
    }

    // int32 MAC
    {
        volatile int32_t a = 100;
        volatile int32_t b = 64;
        volatile int32_t acc = 0;
        XTmrCtr_Start(&timer, 0);
        for (int i = 0; i < N; i++) {
            acc += a * b;
        }
        uint32_t elapsed = XTmrCtr_GetValue(&timer, 0);
        XTmrCtr_Stop(&timer, 0);
        sink = acc;
        xil_printf("int32 MAC:     %d cycles\r\n", (int)elapsed);
    }

    // float MAC
    {
        volatile float a = 100.0f;
        volatile float b = 64.0f;
        volatile float acc = 0.0f;
        XTmrCtr_Start(&timer, 0);
        for (int i = 0; i < N; i++) {
            acc += a * b;
        }
        uint32_t elapsed = XTmrCtr_GetValue(&timer, 0);
        XTmrCtr_Stop(&timer, 0);
        sink = (int32_t)acc;
        xil_printf("float MAC:     %d cycles\r\n", (int)elapsed);
    }

    // float requant (mirrors your CNN)
    {
        volatile int32_t acc_int = 12345;
        volatile float s = 0.00787f;
        volatile int32_t result = 0;
        XTmrCtr_Start(&timer, 0);
        for (int i = 0; i < N; i++) {
            float val = (float)acc_int * s;
            result = (int32_t)(val + (val >= 0.0f ? 0.5f : -0.5f));
        }
        uint32_t elapsed = XTmrCtr_GetValue(&timer, 0);
        XTmrCtr_Stop(&timer, 0);
        sink = result;
        xil_printf("float requant: %d cycles\r\n", (int)elapsed);
    }

    while(1);
}

#include "xiic.h"
#include "xparameters.h"
#include "xil_io.h"
#include "unistd.h"

// ============================================================
// Defines
// ============================================================
#define OV7670_ADDR         0x21  // 7-bit I2C address

#define CAM_BASEADDR        XPAR_CAM_CAPTURE_BASEADDR
#define STATUS_REG          0x00
#define DATA_REG            0x04
#define VSYNC_BIT           0x01
#define PIXEL_READY         0x02

#define FRAME_BUFFER_BASEADDR XPAR_BRAM_0_BASEADDR

// ============================================================
// 1. Camera register init via SCCB (I2C)
// ============================================================
void cam_write_reg(XIic *iic, u8 reg, u8 val) {
    u8 buf[2] = {reg, val};
    XIic_Send(iic->BaseAddress, OV7670_ADDR, buf, 2, XIIC_STOP);
}

void cam_init(XIic *iic) {
    cam_write_reg(iic, 0x12, 0x80);  // reset
    usleep(100000);
    cam_write_reg(iic, 0x12, 0x00);  // YUV mode
    cam_write_reg(iic, 0x11, 0x01);  // clock prescaler
    cam_write_reg(iic, 0x0C, 0x00);
    cam_write_reg(iic, 0x3E, 0x00);
}

// ============================================================
// 2. Read pixel data from capture IP
// ============================================================
void read_frame(u8 *framebuf) {
    // Wait for VSYNC (frame start)
    while (!(Xil_In32(CAM_BASEADDR + STATUS_REG) & VSYNC_BIT));

    for (int i = 0; i < 320 * 240; i++) {
        // Poll ready flag from capture IP
        while (!(Xil_In32(CAM_BASEADDR + STATUS_REG) & PIXEL_READY));
        framebuf[i] = Xil_In32(CAM_BASEADDR + DATA_REG) & 0xFF;
    }
}

// ============================================================
// 3. Write packed pixels to AXI frame buffer
// ============================================================
void write_to_framebuffer(u8 *framebuf) {
    for (int i = 0; i < 320 * 240 / 4; i++) {
        // Pack 4 pixels into 16 bits (4 bits each, matching memory layout)
        u16 packed = ((framebuf[i*4]   & 0xF0) >> 4) |
                     ((framebuf[i*4+1] & 0xF0))      |
                     ((framebuf[i*4+2] & 0xF0) << 4) |
                     ((framebuf[i*4+3] & 0xF0) << 8);
        Xil_Out16(FRAME_BUFFER_BASEADDR + i * 2, packed);
    }
}

// ============================================================
// 4. Main loop
// ============================================================
int main() {
    XIic iic;
    XIic_Initialize(&iic, XPAR_IIC_0_DEVICE_ID);
    cam_init(&iic);

    u8 framebuf[320 * 240];

    while (1) {
        read_frame(framebuf);
        write_to_framebuffer(framebuf);
    }

    return 0;
}

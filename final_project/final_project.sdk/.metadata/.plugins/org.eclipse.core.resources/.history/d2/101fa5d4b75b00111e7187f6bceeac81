#include "xparameters.h"
#include "xuartlite.h"
#include "cnn.h"
#include "weights.h"

XUartLite uart;
signed char input_buf[784];

void uart_read(u8 *buf, int n) {
    int received = 0;
    while (received < n) {
        received += XUartLite_Recv(&uart, buf + received, n - received);
    }
}

int main() {
    XUartLite_Initialize(&uart, XPAR_UARTLITE_0_DEVICE_ID);
    u8 raw[784];

    while (1) {
        // 1. Wait for the 0xFF 0xFF 0xFF 0xFF sync marker
        int m = 0;
        while (m < 4) {
            u8 b;
            uart_read(&b, 1);
            if (b == 0xFF) m++;
            else m = 0;
        }

        // 2. Read the 784 payload bytes
        uart_read(raw, 784);

        // 3. THE FIX: Shift the 0 to 254 range down to -128 to +126
        // This converts Python's '0' background into the CNN's '-128' background.
        for (int i = 0; i < 784; i++) {
            input_buf[i] = (signed char)((int)raw[i] - 128);
        }

        // 4. Run inference on the properly quantized data
//        int digit = infer(input_buf);
        int digit = 7;
        u8 result = (u8)digit;

        // 5. Send prediction back to Python
        XUartLite_Send(&uart, &result, 1);
    }

    return 0;
}
